<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive icon foreground: an ID card (rounded rectangle, photo block +
  3 text lines) with NFC broadcast arcs radiating from its top-right
  corner. Drawn on the standard 108x108dp adaptive canvas; the card and
  arcs sit inside the central ~66dp safe zone (21..87) so they survive
  circle/squircle/rounded-square masking on every launcher.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- ID card body -->
    <path
        android:fillColor="@color/brand_white"
        android:pathData="M32,40 L76,40 Q82,40 82,46 L82,70 Q82,76 76,76 L32,76 Q26,76 26,70 L26,46 Q26,40 32,40 Z" />

    <!-- Photo placeholder block -->
    <path
        android:fillColor="@color/brand_gold"
        android:pathData="M35,46 L45,46 Q48,46 48,49 L48,61 Q48,64 45,64 L35,64 Q32,64 32,61 L32,49 Q32,46 35,46 Z" />

    <!-- Text line 1 -->
    <path
        android:fillColor="@color/brand_navy_deep"
        android:pathData="M55.5,48 L74.5,48 Q76,48 76,49.5 Q76,51 74.5,51 L55.5,51 Q54,51 54,49.5 Q54,48 55.5,48 Z" />

    <!-- Text line 2 -->
    <path
        android:fillColor="@color/brand_navy_deep"
        android:pathData="M55.5,56 L70.5,56 Q72,56 72,57.5 Q72,59 70.5,59 L55.5,59 Q54,59 54,57.5 Q54,56 55.5,56 Z" />

    <!-- Text line 3 -->
    <path
        android:fillColor="@color/brand_navy_deep"
        android:pathData="M55.5,63 L74.5,63 Q76,63 76,64.5 Q76,66 74.5,66 L55.5,66 Q54,66 54,64.5 Q54,63 55.5,63 Z" />

    <!-- NFC broadcast arcs, radiating outward from the card's top-right corner -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="@color/brand_gold"
        android:strokeWidth="3"
        android:strokeLineCap="round"
        android:strokeAlpha="1.0"
        android:pathData="M82,35 A5,5 0 0 1 87,40" />
    <path
        android:fillColor="#00000000"
        android:strokeColor="@color/brand_gold"
        android:strokeWidth="2.5"
        android:strokeLineCap="round"
        android:strokeAlpha="0.8"
        android:pathData="M82,30 A10,10 0 0 1 92,40" />
    <path
        android:fillColor="#00000000"
        android:strokeColor="@color/brand_gold"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:strokeAlpha="0.6"
        android:pathData="M82,25 A15,15 0 0 1 97,40" />

</vector>
